{
  "info": {
    "name": "P18 Gym & Fitness Membership API",
    "description": "Complete API collection for the Gym Membership Management System demo, including happy path, validation, auth, and conflict tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.environment.set('adminToken', json.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@gym.local\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login trainer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) pm.environment.set('trainerToken', json.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"trainer@gym.local\",\n  \"password\": \"Trainer@123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Register member",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.environment.set('memberToken', json.data.token);",
                  "  pm.environment.set('memberId', json.data.user._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Member Demo\",\n  \"email\": \"member-demo-{{$timestamp}}@gym.local\",\n  \"password\": \"Member@123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Duplicate email (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin Clone\",\n  \"email\": \"admin@gym.local\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Invalid email (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bad\",\n  \"email\": \"not-an-email\",\n  \"password\": \"Member@123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Wrong password (expect 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@gym.local\",\n  \"password\": \"wrong-password\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Missing token (expect 401)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Membership Plans",
      "item": [
        {
          "name": "Create plan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data._id) pm.environment.set('planId', json.data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Premium\",\n  \"durationMonths\": 1,\n  \"price\": 1499,\n  \"description\": \"One month premium\"\n}"
            },
            "url": "{{baseUrl}}/api/plans"
          }
        },
        {
          "name": "List plans",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/plans"
          }
        },
        {
          "name": "Get plan",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/plans/{{planId}}"
          }
        },
        {
          "name": "Update plan",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated description\"\n}"
            },
            "url": "{{baseUrl}}/api/plans/{{planId}}"
          }
        },
        {
          "name": "Member cannot create plan (expect 403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hacked\",\n  \"durationMonths\": 1,\n  \"price\": 1\n}"
            },
            "url": "{{baseUrl}}/api/plans"
          }
        }
      ]
    },
    {
      "name": "Memberships",
      "item": [
        {
          "name": "Purchase membership",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data._id) pm.environment.set('membershipId', json.data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{planId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/memberships"
          }
        },
        {
          "name": "My memberships",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": "{{baseUrl}}/api/memberships/my"
          }
        },
        {
          "name": "Get membership",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": "{{baseUrl}}/api/memberships/{{membershipId}}"
          }
        },
        {
          "name": "Renew membership",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{planId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/memberships/{{membershipId}}/renew"
          }
        },
        {
          "name": "Duplicate active membership (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{planId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/memberships"
          }
        }
      ]
    },
    {
      "name": "Trainers",
      "item": [
        {
          "name": "Create trainer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.profile) {",
                  "  pm.environment.set('trainerId', json.data.profile._id);",
                  "  pm.environment.set('trainerUserId', json.data.user._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Trainer\",\n  \"email\": \"new-trainer-{{$timestamp}}@gym.local\",\n  \"password\": \"Trainer@123\",\n  \"specialization\": \"Yoga\"\n}"
            },
            "url": "{{baseUrl}}/api/trainers"
          }
        },
        {
          "name": "List trainers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/trainers"
          }
        }
      ]
    },
    {
      "name": "Classes",
      "item": [
        {
          "name": "Create class",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data._id) pm.environment.set('classId', json.data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trainerId\": \"{{trainerUserId}}\",\n  \"title\": \"Yoga\",\n  \"description\": \"Morning yoga\",\n  \"startTime\": \"2030-01-15T10:00:00.000Z\",\n  \"endTime\": \"2030-01-15T11:00:00.000Z\",\n  \"capacity\": 2\n}"
            },
            "url": "{{baseUrl}}/api/classes"
          }
        },
        {
          "name": "List classes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": "{{baseUrl}}/api/classes"
          }
        },
        {
          "name": "Create class capacity 0 (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trainerId\": \"{{trainerUserId}}\",\n  \"title\": \"Bad\",\n  \"startTime\": \"2030-01-16T10:00:00.000Z\",\n  \"endTime\": \"2030-01-16T11:00:00.000Z\",\n  \"capacity\": 0\n}"
            },
            "url": "{{baseUrl}}/api/classes"
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Book class",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data._id) pm.environment.set('bookingId', json.data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": "{{baseUrl}}/api/classes/{{classId}}/book"
          }
        },
        {
          "name": "My bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": "{{baseUrl}}/api/bookings/my"
          }
        },
        {
          "name": "Duplicate booking (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": "{{baseUrl}}/api/classes/{{classId}}/book"
          }
        },
        {
          "name": "Cancel booking",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}/cancel"
          }
        },
        {
          "name": "Class bookings (admin/trainer)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/classes/{{classId}}/bookings"
          }
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "Check in",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"CLASS\",\n  \"classId\": \"{{classId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/attendance/checkin"
          }
        },
        {
          "name": "My attendance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": "{{baseUrl}}/api/attendance/my"
          }
        },
        {
          "name": "Class attendance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{trainerToken}}" }],
            "url": "{{baseUrl}}/api/attendance/class/{{classId}}"
          }
        }
      ]
    },
    {
      "name": "Notes",
      "item": [
        {
          "name": "Create note",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data._id) pm.environment.set('noteId', json.data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{trainerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"WORKOUT\",\n  \"title\": \"Day 1\",\n  \"content\": \"Warm up and mobility.\"\n}"
            },
            "url": "{{baseUrl}}/api/members/{{memberId}}/notes"
          }
        },
        {
          "name": "List notes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": "{{baseUrl}}/api/members/{{memberId}}/notes"
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data[0]) pm.environment.set('notificationId', json.data[0]._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": "{{baseUrl}}/api/notifications"
          }
        },
        {
          "name": "Mark notification read",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": "{{baseUrl}}/api/notifications/{{notificationId}}/read"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Member dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": "{{baseUrl}}/api/member/dashboard"
          }
        },
        {
          "name": "Trainer dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{trainerToken}}" }],
            "url": "{{baseUrl}}/api/trainer/dashboard"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Attendance report",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/admin/reports/attendance"
          }
        },
        {
          "name": "Membership report",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/admin/reports/memberships"
          }
        },
        {
          "name": "Member cannot view reports (expect 403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": "{{baseUrl}}/api/admin/reports/attendance"
          }
        }
      ]
    }
  ]
}
